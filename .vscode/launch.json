{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/.out/Monolith.dll",
            // "args": [],
            "args": ["index"],
            "env": { "MONOLITH_APPDATA": "./APPDATA" },

            "cwd": "${workspaceFolder}/.out/",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "stopAtEntry": false
        },
        {
            "name": "Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}